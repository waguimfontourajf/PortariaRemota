# Copie para a raiz do projeto como ".env" e preencha.
# Depois rode: php artisan key:generate

APP_NAME="Portaria Remota"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://portariaremota.meusistema.api.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

PORTARIA_MODO=central
PORTARIA_EXIGIR_2FA=true
# IPs dos proxies confiáveis (o cloudflared roda no próprio servidor)
PORTARIA_PROXIES_CONFIAVEIS=127.0.0.1,::1

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portaria_remota
DB_USERNAME=portaria
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@meusistema.api.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
